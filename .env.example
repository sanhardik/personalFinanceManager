# Personal Finance Manager — Environment Configuration
# Copy this file to backend/.env and fill in your values.
# Generated automatically by install.py — edit as needed.

# ── Database type ─────────────────────────────────────────────
# Options: "sqlite" (no Docker needed) | "mariadb"
DB_TYPE=sqlite

# ── SQLite (used when DB_TYPE=sqlite) ─────────────────────────
# Path is relative to the backend/ directory.
SQLITE_PATH=data/finance.db

# ── MariaDB (used when DB_TYPE=mariadb) ───────────────────────
# Uncomment and fill in if using Docker+MariaDB or an external DB.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=finance_user
# DB_PASSWORD=finance_pass
# DB_NAME=finance_app

# ── App settings ──────────────────────────────────────────────
# Set DEBUG=True to enable SQL query logging (dev only).
DEBUG=False

# URL of the frontend — used for CORS.
# Production: http://localhost:8000 (FastAPI serves the built frontend)
# Dev:        http://localhost:5173 (Vite dev server)
FRONTEND_URL=http://localhost:8000
